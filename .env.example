# Copy this file to .env and fill in your keys (never commit .env)
GEMINI_API_KEY=your-google-ai-studio-key
GROQ_API_KEY=your-groq-key

# Keyless local mode: uncomment to route EVERY LLM call to a local Ollama server
# (needs `ollama pull llama3.1`). Delete the line to switch back to cloud.
# LLM_MODE=ollama

# Optional overrides:
# GEMINI_MODEL=gemini-flash-latest   (default; gemini-2.5-flash is retired for new keys)
# GROQ_MODEL=llama-3.3-70b-versatile
# OLLAMA_MODEL=llama3.1
# OLLAMA_URL=http://localhost:11434
